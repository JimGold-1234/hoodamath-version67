
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Developer permissions
    function isDeveloper() {
      return signedIn()
        && request.auth.token.email == "jimgoldbloomyt@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.members;
    }

    function isActiveMember(conversationId) {
      return isConversationMember(conversationId)
        && (
          !("activeMembers" in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data)
          || request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.activeMembers
        );
    }

    function blockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "username", "usernameLower", "createdAt"
        ])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.usernameLower is string;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["username", "usernameLower"])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24;

      allow delete: if false;

      match /blocks/{blockedUid} {
        allow read: if signedIn() && request.auth.uid == userId;

        allow create: if signedIn()
          && request.auth.uid == userId
          && blockedUid != userId
          && request.resource.data.keys().hasOnly(["blockedUid", "createdAt"])
          && request.resource.data.blockedUid == blockedUid;

        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      match /conversationPreferences/{conversationId} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == userId;
      }

      match /hiddenMessages/{hiddenMessageId} {
        allow read, create, delete: if signedIn()
          && request.auth.uid == userId;

        allow update: if false;
      }
    }

    match /privateUsers/{userId} {
      allow read, create, update: if signedIn()
        && request.auth.uid == userId;

      allow delete: if false;
    }

    // MESSAGE REQUESTS
    match /messageRequests/{requestId} {
      allow get: if signedIn()
        && (
          isDeveloper()
          || !exists(/databases/$(database)/documents/messageRequests/$(requestId))
          || request.auth.uid == resource.data.senderId
          || request.auth.uid == resource.data.recipientId
        );

      allow list: if signedIn()
        && (
          isDeveloper()
          || request.auth.uid == resource.data.senderId
          || request.auth.uid == resource.data.recipientId
        );

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && requestId == request.auth.uid + "_" + request.resource.data.recipientId
        && !blockedEitherWay(
          request.auth.uid,
          request.resource.data.recipientId
        );

      // Senders may restart rejected or expired requests.
      allow update: if signedIn()
        && request.auth.uid == resource.data.senderId
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "createdAt"])
        && (
          resource.data.status == "rejected"
          || resource.data.status == "expired"
          || (
            resource.data.status == "pending"
            && request.time > resource.data.createdAt + duration.value(3, "h")
          )
        )
        && !blockedEitherWay(
          request.auth.uid,
          resource.data.recipientId
        );

      // Recipients may accept or reject pending requests.
      allow update: if signedIn()
        && request.auth.uid == resource.data.recipientId
        && resource.data.status == "pending"
        && request.time <= resource.data.createdAt + duration.value(3, "h")
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "respondedAt"])
        && request.resource.data.status in ["accepted", "rejected"];

      // Only the verified developer can delete requests.
      allow delete: if isDeveloper();
    }

    match /conversations/{conversationId} {
      allow read: if isConversationMember(conversationId);

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 20
        && request.resource.data.isGroup == true
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == ""
        && request.resource.data.lastSenderId == "";

      allow update: if isActiveMember(conversationId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["lastMessage", "lastSenderId", "updatedAt"])
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 100;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);

        allow create: if isActiveMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && (
            request.resource.data.keys().hasOnly(["senderId", "text", "createdAt"])
            || (
              request.resource.data.type == "system"
              && request.resource.data.keys().hasOnly([
                "senderId", "text", "createdAt", "type"
              ])
            )
          )
          && (
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.isGroup == true
            || !blockedEitherWay(
              request.auth.uid,
              get(/databases/$(database)/documents/conversations/$(conversationId))
                .data.members[0] == request.auth.uid
                ? get(/databases/$(database)/documents/conversations/$(conversationId))
                    .data.members[1]
                : get(/databases/$(database)/documents/conversations/$(conversationId))
                    .data.members[0]
            )
          );

        allow update: if isActiveMember(conversationId)
          && resource.data.senderId == request.auth.uid
          && resource.data.type != "system"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["text", "editedAt", "unsent"])
          && (
            (
              request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 2000
            )
            || (
              request.resource.data.unsent == true
              && request.resource.data.text == ""
            )
          );

        allow delete: if false;
      }
    }
  }
}
