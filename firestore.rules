rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // AUTHENTICATION

    function signedIn() {
      return request.auth != null;
    }

    function isDeveloper() {
      return signedIn()
        && request.auth.token.email == "jimgoldbloomyt@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // CONVERSATION HELPERS

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.members;
    }

    function isActiveMember(conversationId) {
      return isConversationMember(conversationId)
        && (
          !("activeMembers" in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data)
          || request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.activeMembers
        );
    }

    function blockedEitherWay(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocks/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocks/$(a));
    }

    // CHECK THAT A FRIEND REQUEST WAS ACCEPTED
    // IN THE SAME ATOMIC TRANSACTION.

    function acceptedRequestFrom(senderUid, recipientUid) {
      let requestPath = /databases/$(database)/documents/messageRequests/$(senderUid + "_" + recipientUid);

      return existsAfter(requestPath)
        && getAfter(requestPath).data.senderId == senderUid
        && getAfter(requestPath).data.recipientId == recipientUid
        && getAfter(requestPath).data.status == "accepted"
        && recipientUid == request.auth.uid
        && getAfter(requestPath).data.createdAt is timestamp
        && request.time <= getAfter(requestPath).data.createdAt + duration.value(3, "h")
        && !blockedEitherWay(senderUid, recipientUid);
    }

    function validPrivateConversation(members) {
      return members is list
        && members.size() == 2
        && request.auth.uid in members
        && (
          acceptedRequestFrom(members[0], members[1])
          || acceptedRequestFrom(members[1], members[0])
        );
    }

    // USERS

    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          "username", "usernameLower", "createdAt"
        ])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24
        && request.resource.data.usernameLower is string;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["username", "usernameLower"])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 24;

      allow delete: if false;

      // ADMIN REMOVAL NOTICES
      // Users may read and acknowledge only notices stored under their own UID.

      match /adminNotices/{noticeId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if false;
      }

      // BLOCKED USERS

      match /blocks/{blockedUid} {
        allow read: if signedIn()
          && request.auth.uid == userId;

        allow create: if signedIn()
          && request.auth.uid == userId
          && blockedUid != userId
          && request.resource.data.keys().hasOnly(["blockedUid", "createdAt"])
          && request.resource.data.blockedUid == blockedUid;

        allow delete: if signedIn()
          && request.auth.uid == userId;

        allow update: if false;
      }

      // CONVERSATION PREFERENCES

      match /conversationPreferences/{conversationId} {
        allow read, create, update, delete: if signedIn()
          && request.auth.uid == userId;
      }

      // HIDDEN MESSAGES

      match /hiddenMessages/{hiddenMessageId} {
        allow read, create, delete: if signedIn()
          && request.auth.uid == userId;

        allow update: if false;
      }
    }

    // PRIVATE USER DATA

    match /privateUsers/{userId} {
      allow read, create, update: if signedIn()
        && request.auth.uid == userId;

      allow delete: if false;
    }

    // MESSAGE REQUESTS

    match /messageRequests/{requestId} {

      allow get: if signedIn()
        && (
          isDeveloper()
          || !exists(/databases/$(database)/documents/messageRequests/$(requestId))
          || request.auth.uid == resource.data.senderId
          || request.auth.uid == resource.data.recipientId
        );

      allow list: if signedIn()
        && (
          isDeveloper()
          || request.auth.uid == resource.data.senderId
          || request.auth.uid == resource.data.recipientId
        );

      // CREATE FRIEND REQUEST

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && requestId == request.auth.uid + "_" + request.resource.data.recipientId
        && !blockedEitherWay(
          request.auth.uid,
          request.resource.data.recipientId
        );

      // RESTART REJECTED OR EXPIRED REQUEST

      allow update: if signedIn()
        && request.auth.uid == resource.data.senderId
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "createdAt"])
        && (
          resource.data.status == "rejected"
          || resource.data.status == "expired"
          || (
            resource.data.status == "pending"
            && request.time > resource.data.createdAt + duration.value(3, "h")
          )
        )
        && !blockedEitherWay(
          request.auth.uid,
          resource.data.recipientId
        );

      // ACCEPT OR REJECT FRIEND REQUEST

      allow update: if signedIn()
        && request.auth.uid == resource.data.recipientId
        && resource.data.status == "pending"
        && request.time <= resource.data.createdAt + duration.value(3, "h")
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "respondedAt"])
        && request.resource.data.status in ["accepted", "rejected"];

      allow delete: if isDeveloper();
    }

    // CONVERSATIONS

    match /conversations/{conversationId} {

      // ALLOW CHECKING WHETHER A CONVERSATION EXISTS.
      // EXISTING CONVERSATIONS REMAIN PRIVATE TO MEMBERS.

      allow get: if signedIn()
        && (
          !exists(/databases/$(database)/documents/conversations/$(conversationId))
          || isConversationMember(conversationId)
        );

      // This direct resource check works with the members array-contains
      // query used by the sidebar conversation listener.
      allow list: if signedIn()
        && request.auth.uid in resource.data.members;

      // CREATE GROUP OR PRIVATE CONVERSATIONS

      allow create: if signedIn()
        && request.resource.data.members is list
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessage == ""
        && request.resource.data.lastSenderId == ""
        && (
          // GROUP CONVERSATION

          (
            request.resource.data.isGroup == true
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 1
            && request.resource.data.name.size() <= 50
          )

          ||

          // PRIVATE CONVERSATION
          // REQUIRES A VALID ACCEPTED FRIEND REQUEST.

          (
            request.resource.data.isGroup == false
            && request.resource.data.members.size() == 2
            && request.resource.data.members[0] < request.resource.data.members[1]
            && conversationId == request.resource.data.members[0] + "_" + request.resource.data.members[1]
            && request.resource.data.activeMembers == request.resource.data.members
            && validPrivateConversation(request.resource.data.members)
          )
        );

      // UPDATE CONVERSATIONS OR REACTIVATE PRIVATE CHATS

      allow update: if (

        // NORMAL CONVERSATION UPDATES

        (
          isActiveMember(conversationId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["lastMessage", "lastSenderId", "updatedAt"])
          && request.resource.data.lastSenderId == request.auth.uid
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 100
        )

        ||

        // REACTIVATE AN EXISTING PRIVATE CONVERSATION

        (
          signedIn()
          && resource.data.isGroup == false
          && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["activeMembers", "updatedAt"])
          && request.resource.data.activeMembers == resource.data.members
          && request.resource.data.updatedAt == request.time
          && validPrivateConversation(resource.data.members)
        )
      );

      allow delete: if false;

      // MESSAGES

      match /messages/{messageId} {

        allow read: if isConversationMember(conversationId);

        // SEND MESSAGES

        allow create: if isActiveMember(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && (
            request.resource.data.keys().hasOnly([
              "senderId", "text", "createdAt"
            ])
            || (
              request.resource.data.type == "system"
              && request.resource.data.keys().hasOnly([
                "senderId", "text", "createdAt", "type"
              ])
            )
          )
          && (
            get(/databases/$(database)/documents/conversations/$(conversationId))
              .data.isGroup == true
            || !blockedEitherWay(
              request.auth.uid,
              get(/databases/$(database)/documents/conversations/$(conversationId))
                .data.members[0] == request.auth.uid
                ? get(/databases/$(database)/documents/conversations/$(conversationId))
                    .data.members[1]
                : get(/databases/$(database)/documents/conversations/$(conversationId))
                    .data.members[0]
            )
          );

        // EDIT OR UNSEND MESSAGES

        allow update: if isActiveMember(conversationId)
          && resource.data.senderId == request.auth.uid
          && resource.data.type != "system"
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["text", "editedAt", "unsent"])
          && (
            (
              request.resource.data.text is string
              && request.resource.data.text.size() >= 1
              && request.resource.data.text.size() <= 2000
            )
            || (
              request.resource.data.unsent == true
              && request.resource.data.text == ""
            )
          );

        allow delete: if false;
      }
    }
  }
}

